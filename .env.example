# --- Database (Postgres + pgvector) ---
DOMINION_DATABASE_URL=postgresql+asyncpg://dominion:dominion@localhost:5432/dominion

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Strong model for the spine; cheaper model for advisory reviewers. Swap freely.
DOMINION_DRAFT_MODEL=claude-sonnet-4-6
DOMINION_REVIEW_MODEL=claude-haiku-4-5-20251001

# --- Bounded execution (DESIGN §10) ---
DOMINION_SCENE_TOKEN_BUDGET=40000
DOMINION_SCENE_TIME_BUDGET_S=300

# --- API ---
# The desk reaches the API through the Next BFF (same-origin), so CORS is unused in normal operation;
# this only matters if a browser hits the API directly. Dev frontend now runs on :3000.
DOMINION_CORS_ORIGINS=http://localhost:3000
