# --- Bounded execution (DESIGN §10) ---
DOMINION_SCENE_TOKEN_BUDGET=40000
DOMINION_SCENE_TIME_BUDGET_S=300

# --- API ---
DOMINION_CORS_ORIGINS=http://localhost:5173
