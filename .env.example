# --- Database (Postgres + pgvector) ---
# The Compose stack injects DOMINION_DATABASE_URL (see infra/docker-compose.yml); the app normalizes the scheme to asyncpg.
# Set this only to point the app at a specific Postgres instance.
# DOMINION_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/dominion

# --- LiteLLM local gateway (preferred for chat when running litellm-langfuse-gateway) ---
# When LITELLM_VIRTUAL_KEY is a real sk-… key, dominion.workers.llm routes chat through
# the gateway (OpenAI-compatible aliases) and attaches SERVICE_NAME metadata for Langfuse.
# Provider keys below are then unused for chat.
# Provision: uv run llg keys create --models llm-general,openai-general,anthropic-general,gemini-general,grok-general \
#   --max-budget 50 --rpm 120 --key-alias realmwalkers-dev
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_VIRTUAL_KEY=
# Optional force-all alias: LITELLM_MODEL=llm-general
SERVICE_NAME=realmwalkers
# ENVIRONMENT=development

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
# Strong model for the spine; cheaper model for advisory reviewers. Swap freely.
DOMINION_DRAFT_MODEL=claude-sonnet-5
DOMINION_DRAFT_FALLBACK_MODEL=claude-haiku-4-5
DOMINION_REVIEW_MODEL=claude-haiku-4-5-20251001
DOMINION_REVIEW_FALLBACK_MODEL=claude-sonnet-5
# Fallback models for escalation when primary output is truncated or unparseable (Agent Operations panel).
DOMINION_ENRICH_FALLBACK_MODEL=claude-sonnet-5
DOMINION_PACKET_AUTHOR_FALLBACK_MODEL=claude-opus-4-8
DOMINION_PACKET_QA_FALLBACK_MODEL=claude-sonnet-5
DOMINION_SCENE_PACKET_AUTHOR_FALLBACK_MODEL=claude-sonnet-5
DOMINION_SCENE_PACKET_QA_FALLBACK_MODEL=claude-sonnet-5

# --- Other providers (optional) ---
# Any per-role model setting above also accepts a non-Anthropic model id; workers.llm dispatches by
# prefix (claude-* stays on the Anthropic path; grok-* routes to xAI; gemini-* routes to Google;
# gpt-* / o*-* route to OpenAI).
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# XAI_API_KEY=xai-...

# --- Bounded execution (DESIGN §10) ---
DOMINION_SCENE_TOKEN_BUDGET=60000
DOMINION_SCENE_PACKET_PREFIX_PRIME_TOKEN_BUDGET=100000
DOMINION_SCENE_PACKET_CONTEXT_WINDOW_BUDGET=180000
DOMINION_SCENE_TIME_BUDGET_S=300

# --- API ---
# The desk reaches the API through the Next BFF (same-origin), so CORS is unused in the single-service
# deploy. Set this (comma-separated origins) only if a browser hits the API directly from another origin.
# DOMINION_CORS_ORIGINS=
