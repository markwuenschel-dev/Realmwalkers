# Normalize line endings to LF for all text files — stops Windows CRLF churn.
* text=auto eol=lf

# Binary assets: never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary

.github/workflows/*.lock.yml linguist-generated=true merge=ours