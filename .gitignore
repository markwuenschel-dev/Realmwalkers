__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
*.egg-info/
.env
.env.*
!.env.example
frontend/node_modules/
/node_modules/
frontend/dist/
.DS_Store
.vscode/
.idea/
*.lnk
# runtime exhaust — never tracked (DESIGN: keep the tree clean)
logs/
*.log
# local agent tooling — .claude/skills are machine-specific symlinks into .agents/skills/ (the tracked home)
# .cursor/skills/ is tracked (Cursor slash menu reads it; gitignored paths are invisible to Cursor).
# After updating .agents/skills/: pwsh scripts/sync-cursor-skills.ps1 then commit .cursor/skills/
.claude/skills/
# author's local working notes — scratch, never tracked
author notes/
# worker scratch output (e.g. tmp/packet_internal.json) and local MCP working dirs — never tracked
tmp/
mcps/
# Scratch JSON is ignored at the repo ROOT only (anchored /*.json). NEVER use a bare `*.json` here:
# the Railway CLI applies these patterns to its upload walk at any depth REGARDLESS of git tracking,
# so a bare `*.json` silently dropped frontend/package.json, frontend/tsconfig.json, and railway.json
# from every `railway up` context and broke the deploy (2026-07-03).
/*.json
# railway.json must ride in the upload so Railway reads the service config from the context.
!/railway.json
# schema files under src/ are code artifacts that ship in the wheel
# (e.g. chapter_master_packet.schema.json) — keep them tracked.
!src/**/*.schema.json
