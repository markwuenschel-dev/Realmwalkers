__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
# coverage.py byproducts (pytest-cov) — measurement output, never tracked
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
.env
.env.*
!.env.example
frontend/node_modules/
/node_modules/
frontend/dist/
.DS_Store
.vscode/
.idea/
*.lnk
# runtime exhaust — never tracked (DESIGN: keep the tree clean)
logs/
*.log
# local agent tooling — .claude/skills are machine-specific symlinks into .agents/skills/ (the tracked home)
# .cursor/skills/ is tracked (Cursor slash menu reads it; gitignored paths are invisible to Cursor).
# After updating .agents/skills/: pwsh scripts/sync-cursor-skills.ps1 then commit .cursor/skills/
.claude/skills/
# author's local working notes — scratch, never tracked
author notes/
# creative content — manuscript, canon, planning, style — managed OUTSIDE the code repo.
# Untracked deliberately. NOTE: the app reads canon/style/planning/scenes from these dirs at
# runtime (config.py canon_dir/scenes_dir/dialogue_rules_path; docs.py, world.py, seed.py,
# canon_rag), so a fresh clone / CI checkout / deploy sees EMPTY dirs unless this content is
# provisioned separately. Tests must use tmp_path fixtures, never these real dirs.
book1/
book2/
series/
# worker scratch output (e.g. tmp/packet_internal.json) and local MCP working dirs — never tracked
tmp/
mcps/
# Scratch JSON is ignored at the repo ROOT only (anchored /*.json). NEVER use a bare `*.json` here —
# that would also drop tracked nested files like frontend/package.json and frontend/tsconfig.json.
/*.json
# schema files under src/ are code artifacts that ship in the wheel
# (e.g. chapter_master_packet.schema.json) — keep them tracked.
!src/**/*.schema.json
