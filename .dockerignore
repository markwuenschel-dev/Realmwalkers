# Keep the build context small + deterministic (deps are reinstalled in the image).
.git
.claude
.cursor
.agents
.github
.venv
frontend/playwright-report
frontend/test-results
**/node_modules
**/.next
frontend/dist
frontend/out
**/__pycache__
.pytest_cache
.mypy_cache
.ruff_cache
*.pyc
.env
.env.*
tests
docs
# not needed to build or run the image (keeps the context uploaded to the builder small).
# NB: series/, book1/, book2/ (the novel's creative content) are excluded — never in the image. The
# deployed app reads canon from Postgres, not these files; the file-backed viewers are authoring-only.
# NB: root-only entries are anchored with a leading slash. Unanchored patterns match at ANY depth,
# so a bare `package.json` here would also drop frontend/package.json from the build context —
# always anchor root files with a leading slash.
/series/
/book1/
/book2/
/author notes/
/mcps/
/tmp/
/openapi.json
/package.json
/pnpm-lock.yaml
/skills-lock.json
/README.md
/LICENSE.md
/AGENTS.md
/justfile
